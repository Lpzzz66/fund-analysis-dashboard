{
	email {$ACME_EMAIL}
}

{$DASHBOARD_DOMAIN} {
	encode gzip

	log {
		output stdout
		format json
	}

	handle /api/* {
		reverse_proxy api:8000 {
			fail_duration 30s
			timeout 30s
			transport http {
				dial_timeout 5s
				read_timeout 30s
				write_timeout 30s
				response_header_timeout 10s
			}
		}
	}

	handle /health/* {
		reverse_proxy api:8000 {
			fail_duration 30s
			timeout 10s
			transport http {
				dial_timeout 5s
				response_header_timeout 5s
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
